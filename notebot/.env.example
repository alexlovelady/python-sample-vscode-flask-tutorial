# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TEXT_CHANNEL_ID=

# Spark / vLLM
VLLM_BASE_URL=http://spark-2441:8000/v1
VLLM_MODEL=nvidia/Nemotron-Super-49B-v1

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Tasks

# Audio capture
# Install VB-Cable (vb-audio.com/Cable), set Discord Output → CABLE Input,
# then set Windows Sound → Recording → CABLE Output → Listen → Headphones (G7)
LOOPBACK_DEVICE=CABLE Output

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_TITLE=AMP Titans Meeting Notes
